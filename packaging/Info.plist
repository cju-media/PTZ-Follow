<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>PTZ Follow</string>
    <key>CFBundleDisplayName</key>
    <string>PTZ Follow</string>
    <key>CFBundleIdentifier</key>
    <string>com.ptzfollow.app</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>ptz-tracker</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.video</string>
    <!-- Deliberately omitting LSUIElement: this app previously had no Dock icon at all
         (LSUIElement=true), but users expect a normal Dock presence to quit it the way they quit
         any other Mac app (right-click Dock icon > Quit, or Cmd+Q while it's frontmost) rather
         than relying solely on the in-page "Quit App" button. Whichever way the user quits it
         (Dock, Cmd+Q, "killall ptz-tracker", a system logout) terminates this non-AppKit process
         via SIGTERM - server.js has a SIGTERM handler (see gracefulShutdown()) that stops tracker
         child processes cleanly before exiting, so this doesn't orphan them. Verified: with the
         Dock icon present, the app launches and settles normally (a brief launch bounce, not
         indefinite), and `kill -TERM` on the process - what Dock Quit/Cmd+Q ultimately send to a
         non-AppKit app like this one - cleanly stops every tracker child before exiting. -->
</dict>
</plist>
